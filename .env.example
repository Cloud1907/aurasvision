# AurasVision ortam değişkenleri — kopyala: cp .env.example .env
# .env repoya GİRMEZ (.gitignore). Gerçek değerleri yalnız client makinesinde tut.

# Panel + API erişim anahtarı (client kurulumunda ZORUNLU — boşsa panel şifresiz!)
AURAS_TOKEN=degistir-uzun-rastgele-anahtar

# Üretim veritabanı (docker compose 'db' servisi — host portu 5433).
# Boş bırakılırsa SQLite fallback (yalnız demo; yedeksiz).
DATABASE_URL=postgresql://auras:auras@localhost:5433/auras

# Olay veri yolu (worker → ingestor). Yalnız Test ekranı kullanılacaksa boş kalabilir.
REDIS_URL=redis://localhost:6379/0

# QA E2E kimlikleri (test koşarken; repoya şifre yazılmaz)
# QA_USER=
# QA_PASS=
